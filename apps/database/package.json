{
  "name": "database",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@config/eslint": "^1.0.0",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "db:migrate": "tsup --onSuccess \"node dist/migrate.cjs\"",
    "db:reset": "tsup --watch --onSuccess \"node dist/reset-db.cjs\"",
    "db:seed": "tsup --watch --onSuccess \"node dist/seed.cjs\"",
    "build": "tsup",
    "start": "node dist/index.cjs",
    "lint": "eslint src/ --max-warnings 0",
    "test": "jest --detectOpenHandles",
    "test:cov": "jest --detectOpenHandles --coverage",
    "tscheck": "npx tsc -p tsconfig.json --maxNodeModuleJsDepth 0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "mysql2": "^3.16.0",
    "readline": "^1.3.0"
  }
}
